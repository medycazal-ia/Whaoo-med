# Supabase (auth + base de données comptes + stockage interne par défaut)
# Région recommandée : Frankfurt (UE) — voir DECISIONS.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (connexion + connecteur Google Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Airtable (connecteur de données courses)
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# Microsoft Graph (connecteur Excel/OneDrive)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Notifications push (VAPID) — générer sa propre paire de clés avec :
#   npx web-push generate-vapid-keys
# Ne nécessite aucun compte tiers, purement auto-généré.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secret partagé avec Vercel Cron pour sécuriser /api/cron/rappels
# (Vercel ajoute automatiquement "Authorization: Bearer $CRON_SECRET"
# aux requêtes cron dès que cette variable est configurée sur le projet).
CRON_SECRET=

# Lien de la cagnotte de soutien (section 10.3) — facultatif, modifiable sans redéploiement
SUPPORT_LINK_URL=

# OpenAI (transcription Whisper) — solution de repli pour la dictée vocale
# sur Safari iOS/iPadOS, qui n'implémente pas l'API SpeechRecognition des
# navigateurs. Clé sur platform.openai.com → API keys. Facturé à l'usage
# (~0,006 $/minute d'audio), aucun coût fixe.
OPENAI_API_KEY=

# URL publique de l'app (utile pour les redirections OAuth et les liens de parrainage)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (Claude vision) — lecture des tickets de caisse scannés par IA,
# essayée en priorité avant l'OCR local (Tesseract). Clé sur
# console.anthropic.com/settings/keys, nécessite un moyen de paiement
# (Billing) mais coûte de l'ordre du centime par ticket scanné. Tant que
# cette variable n'est pas définie, l'appli retombe automatiquement sur
# l'OCR local dans le navigateur.
ANTHROPIC_TICKET_API_KEY=
# Nécessaire seulement si la clé ci-dessus est une clé "organisation" non
# rattachée à un workspace précis (l'API renvoie alors une erreur 400
# explicite qui le demande) — l'ID du workspace se trouve dans
# console.anthropic.com/settings/workspaces.
ANTHROPIC_TICKET_WORKSPACE_ID=

# Back-office (/app/admin) : emails des comptes autorisés à y accéder,
# séparés par des virgules. Tant que la variable est vide, le back-office
# est inaccessible pour tout le monde (page introuvable).
ADMIN_EMAILS=

# ElevenLabs (voix humaine) — prononce "Bonjour {prénom}" à la connexion et
# "Au revoir {prénom}" à la déconnexion. Clé sur elevenlabs.io → Profile →
# API keys, nécessite un moyen de paiement mais coûte quelques centimes par
# appel (le prénom change à chaque fois, impossible de pré-enregistrer le
# son à l'avance). Tant que cette variable n'est pas définie, l'appli reste
# silencieuse (pas de voix, pas d'erreur visible).
ELEVENLABS_API_KEY=
# Voix par défaut (française, "Rachel") — facultatif, une autre voix peut
# être choisie sur elevenlabs.io → Voices, en copiant son ID.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
